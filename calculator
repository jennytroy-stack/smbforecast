  </main>

  <!-- Notification Toast -->
  <div id="toast" class="fixed bottom-6 right-6 bg-trimble-navy text-white px-4 py-3 rounded-xl shadow-xl transform translate-y-20 opacity-0 transition-all duration-300 text-xs font-semibold z-50 flex items-center space-x-2 border border-slate-700">
    <svg class="w-4 h-4 text-trimble-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toastMsg">Action completed!</span>
  </div>

  <script>
    // Trimble Modus color-calibrated stages:
    // Discovery: 33.3%, Needs Analysis: 27.5%, Quote & Proposal: 54.1%, Negotiate: 83.1%
    const defaultStages = [
      { id: 'stage1', name: 'Stage 1: Discovery', winRate: 33.3, amount: 80000, color: '#595e63' },
      { id: 'stage2', name: 'Stage 2: Needs Analysis', winRate: 27.5, amount: 45000, color: '#217cbb' },
      { id: 'stage3', name: 'Stage 3: Quote & Proposal', winRate: 54.1, amount: 65000, color: '#0063a3' },
      { id: 'stage4', name: 'Stage 4: Negotiate / Sent for Signature', winRate: 83.1, amount: 35000, color: '#1e8a44' }
    ];

    let stages = JSON.parse(JSON.stringify(defaultStages));
    let forecastChartInstance = null;
    let paceMode = 'weekly'; // 'weekly' or 'daily'

    // Format currency helper
    const fmtUSD = (num) => {
      return '$' + Math.round(num).toLocaleString('en-US');
    };

    function renderStageInputs() {
      const container = document.getElementById('stagesContainer');
      container.innerHTML = '';

      stages.forEach((st, idx) => {
        const row = document.createElement('div');
        row.className = 'p-3 bg-slate-50/80 rounded-xl border border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs';
        row.innerHTML = `
          <div class="flex-1">
            <div class="font-bold text-slate-800 flex items-center space-x-1.5">
              <span class="w-2 h-2 rounded-full" style="background-color: ${st.color}"></span>
              <span>${st.name}</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">Historical SFDC Win Rate: 
              <span class="font-bold text-slate-700 stage-winrate-label">${st.winRate}%</span>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <div class="w-24">
              <label class="block text-[10px] text-slate-500 mb-0.5 font-medium">Win Rate (%)</label>
              <input type="number" step="0.1" min="0" max="100" value="${st.winRate}" data-idx="${idx}" class="stage-rate-input w-full px-2 py-1 bg-white border border-slate-200 rounded-md font-semibold text-slate-800 text-center focus:ring-1 focus:ring-trimble-blue">
            </div>
            <div class="w-32">
              <label class="block text-[10px] text-slate-500 mb-0.5 font-medium">Open Value ($)</label>
              <div class="relative">
                <span class="absolute left-2 top-1 text-slate-400 font-bold text-[10px]">$</span>
                <input type="number" step="1000" min="0" value="${st.amount}" data-idx="${idx}" class="stage-amount-input w-full pl-5 pr-2 py-1 bg-white border border-slate-200 rounded-md font-bold text-slate-800 focus:ring-1 focus:ring-trimble-blue">
              </div>
            </div>
          </div>
        `;
        container.appendChild(row);
      });

      // Bind input events
      document.querySelectorAll('.stage-rate-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const idx = parseInt(e.target.dataset.idx);
          stages[idx].winRate = parseFloat(e.target.value) || 0;
          e.target.closest('div').parentElement.previousElementSibling.querySelector('.stage-winrate-label').textContent = `${stages[idx].winRate}%`;
          calculateAndRender();
        });
      });

      document.querySelectorAll('.stage-amount-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const idx = parseInt(e.target.dataset.idx);
          stages[idx].amount = parseFloat(e.target.value) || 0;
          calculateAndRender();
        });
      });
    }

    function calculateAndRender() {
      // 1. Rep Target Inputs
      const repName = document.getElementById('inputRepName').value || 'Rep';
      const weeksLeft = Math.max(1, parseFloat(document.getElementById('inputWeeksLeft').value) || 6);
      const quota = Math.max(1, parseFloat(document.getElementById('inputQuota').value) || 150000);
      const closedWon = Math.max(0, parseFloat(document.getElementById('inputClosedWon').value) || 0);
      const acv = Math.max(500, parseFloat(document.getElementById('inputACV').value) || 5869);
      const salesCycleDays = parseFloat(document.getElementById('inputSalesCycle').value) || 32;

      const convIntro = (parseFloat(document.getElementById('inputConvIntro').value) || 20) / 100;
      const convDisc = (parseFloat(document.getElementById('inputConvDisc').value) || 65) / 100;
      const convProposal = (parseFloat(document.getElementById('inputConvNeeds').value) || 54) / 100;

      // Update slider labels
      document.getElementById('convIntroLabel').textContent = `${Math.round(convIntro * 100)}%`;
      document.getElementById('convDiscLabel').textContent = `${Math.round(convDisc * 100)}%`;
      document.getElementById('convNeedsLabel').textContent = `${Math.round(convProposal * 100)}%`;
      document.getElementById('weeksCallout').textContent = weeksLeft;

      // 2. Pipe Calculations
      let totalRawPipeline = 0;
      let totalWeightedPipeline = 0;

      stages.forEach(st => {
        totalRawPipeline += st.amount;
        totalWeightedPipeline += (st.amount * (st.winRate / 100));
      });

      document.getElementById('totalRawPipelineDisplay').textContent = `Total Open: ${fmtUSD(totalRawPipeline)}`;
      document.getElementById('calculatedWeightedPipe').textContent = fmtUSD(totalWeightedPipeline);

      // 3. Projected Landing & Gap
      const projectedRevenue = closedWon + totalWeightedPipeline;
      const attainmentPct = Math.round((projectedRevenue / quota) * 100);
      const gapToQuota = Math.max(0, quota - projectedRevenue);
      const surplus = projectedRevenue > quota ? projectedRevenue - quota : 0;
      const coverageRatio = (totalRawPipeline / (quota - closedWon > 0 ? quota - closedWon : 1)).toFixed(2);

      // 4. Activity Waterfall based on Gap
      const targetVolumeDollars = gapToQuota > 0 ? gapToQuota : (quota * 0.15);
      const dealsNeededToWin = targetVolumeDollars / acv;

      const proposalWinRate = (stages[2]?.winRate || 54.1) / 100;
      const proposalsNeeded = dealsNeededToWin / (proposalWinRate > 0 ? proposalWinRate : 0.54);
      const discoveryCallsNeeded = proposalsNeeded / (convProposal > 0 ? convProposal : 0.54);
      const introMeetingsNeeded = discoveryCallsNeeded / (convDisc > 0 ? convDisc : 0.65);

      const divisor = paceMode === 'weekly' ? weeksLeft : (weeksLeft * 5);
      const unitLabel = paceMode === 'weekly' ? '/ wk' : '/ day';

      const paceWins = (dealsNeededToWin / divisor).toFixed(1);
      const paceProposals = (proposalsNeeded / divisor).toFixed(1);
      const paceDiscovery = (discoveryCallsNeeded / divisor).toFixed(1);
      const paceIntros = (introMeetingsNeeded / divisor).toFixed(1);

      document.getElementById('cardProjectedTotal').textContent = fmtUSD(projectedRevenue);
      document.getElementById('cardQuotaPct').textContent = `${attainmentPct}% of Quota`;
      document.getElementById('cardCoverageRatio').textContent = `${coverageRatio}x`;

      if (gapToQuota > 0) {
        document.getElementById('cardGapAmount').textContent = `-${fmtUSD(gapToQuota)}`;
        document.getElementById('cardGapAmount').className = 'text-2xl font-black text-rose-600 mt-1';
        document.getElementById('cardGapSubtext').textContent = `${fmtUSD(gapToQuota)} gap to bridge`;
        document.getElementById('cardGapBar').className = 'w-1.5 h-full absolute left-0 top-0 bg-rose-500';
      } else {
        document.getElementById('cardGapAmount').textContent = `+${fmtUSD(surplus)}`;
        document.getElementById('cardGapAmount').className = 'text-2xl font-black text-trimble-green mt-1';
        document.getElementById('cardGapSubtext').textContent = `Pacing ahead of quota!`;
        document.getElementById('cardGapBar').className = 'w-1.5 h-full absolute left-0 top-0 bg-trimble-green';
      }

      // Coverage health badge
      const covHealthElem = document.getElementById('cardCoverageHealth');
      if (coverageRatio < 2.0) {
        covHealthElem.textContent = 'Low pipeline coverage (<2.0x)';
        covHealthElem.className = 'text-xs font-semibold text-rose-600 mt-1';
      } else if (coverageRatio <= 3.5) {
        covHealthElem.textContent = 'Healthy coverage (Target: 2.51x)';
        covHealthElem.className = 'text-xs font-medium text-trimble-green mt-1';
      } else {
        covHealthElem.textContent = 'High coverage (>3.5x) - check deal hygiene';
        covHealthElem.className = 'text-xs font-medium text-trimble-blue mt-1';
      }

      // Status Alert Header
      const statusAlert = document.getElementById('statusAlert');
      const statusIconBg = document.getElementById('statusIconBg');
      const statusBadge = document.getElementById('statusBadge');
      const statusRepName = document.getElementById('statusRepName');
      const statusHeadline = document.getElementById('statusHeadline');

      statusRepName.textContent = `${repName} — ${weeksLeft} Wks Left`;
      document.getElementById('gapMetric').textContent = gapToQuota > 0 ? fmtUSD(gapToQuota) : `$0 (Surplus: ${fmtUSD(surplus)})`;
      document.getElementById('weeklyIntrosMetric').textContent = `${(introMeetingsNeeded / weeksLeft).toFixed(1)} / wk`;
      document.getElementById('weeklyProposalsMetric').textContent = `${(proposalsNeeded / weeksLeft).toFixed(1)} / wk`;

      if (attainmentPct >= 100) {
        statusAlert.className = 'mb-6 rounded-2xl p-4 sm:p-5 border border-emerald-200 bg-emerald-50/70 transition-all duration-300 flex flex-col md:flex-row items-start md:items-center justify-between gap-4';
        statusIconBg.className = 'w-12 h-12 rounded-xl bg-trimble-green flex items-center justify-center text-white shrink-0 shadow-sm';
        statusBadge.className = 'text-xs uppercase font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-200 text-emerald-800';
        statusBadge.textContent = 'Quota Achieved Pace';
        statusHeadline.textContent = `Projected to land at ${attainmentPct}% of Quota (${fmtUSD(projectedRevenue)})`;
      } else if (attainmentPct >= 80) {
        statusAlert.className = 'mb-6 rounded-2xl p-4 sm:p-5 border border-amber-200 bg-amber-50/70 transition-all duration-300 flex flex-col md:flex-row items-start md:items-center justify-between gap-4';
        statusIconBg.className = 'w-12 h-12 rounded-xl bg-trimble-yellow flex items-center justify-center text-white shrink-0 shadow-sm';
        statusBadge.className = 'text-xs uppercase font-extrabold px-2.5 py-0.5 rounded-full bg-amber-200 text-amber-900';
        statusBadge.textContent = 'Striking Distance (80-99%)';
        statusHeadline.textContent = `Projected at ${attainmentPct}% (${fmtUSD(projectedRevenue)}). ${fmtUSD(gapToQuota)} gap to close.`;
      } else {
        statusAlert.className = 'mb-6 rounded-2xl p-4 sm:p-5 border border-rose-200 bg-rose-50/70 transition-all duration-300 flex flex-col md:flex-row items-start md:items-center justify-between gap-4';
        statusIconBg.className = 'w-12 h-12 rounded-xl bg-trimble-red flex items-center justify-center text-white shrink-0 shadow-sm';
        statusBadge.className = 'text-xs uppercase font-extrabold px-2.5 py-0.5 rounded-full bg-rose-200 text-rose-900';
        statusBadge.textContent = 'Critical Pipeline Gap (<80%)';
        statusHeadline.textContent = `Projected at ${attainmentPct}% (${fmtUSD(projectedRevenue)}). Need ${(introMeetingsNeeded / weeksLeft).toFixed(1)} intros/week immediately.`;
      }

      document.getElementById('metricWinsNeeded').textContent = dealsNeededToWin.toFixed(1);
      document.getElementById('metricWinsPace').textContent = `${paceWins} ${unitLabel}`;
      document.getElementById('metricProposalsTotal').textContent = Math.ceil(proposalsNeeded);
      document.getElementById('metricProposalsPace').textContent = `${paceProposals} ${unitLabel}`;
      document.getElementById('metricDiscTotal').textContent = Math.ceil(discoveryCallsNeeded);
      document.getElementById('metricDiscPace').textContent = `${paceDiscovery} ${unitLabel}`;
      document.getElementById('metricIntroTotal').textContent = Math.ceil(introMeetingsNeeded);
      document.getElementById('metricIntroPace').textContent = `${paceIntros} ${unitLabel}`;

      // Progress Bars
      const closedPct = Math.min(100, Math.round((closedWon / quota) * 100));
      const pipePct = Math.min(100 - closedPct, Math.round((totalWeightedPipeline / quota) * 100));
      document.getElementById('barClosedWon').style.width = `${closedPct}%`;
      document.getElementById('barWeightedPipe').style.width = `${pipePct}%`;
      document.getElementById('quotaProgressText').textContent = `${attainmentPct}% (${fmtUSD(projectedRevenue)} / ${fmtUSD(quota)})`;

      // Step-by-step formula breakdown
      document.getElementById('formulaExplanation').innerHTML = `
        &bull; <strong>Revenue Gap:</strong> Quota (${fmtUSD(quota)}) - [Won (${fmtUSD(closedWon)}) + Weighted Pipe (${fmtUSD(totalWeightedPipeline)})] = <strong>${fmtUSD(gapToQuota)}</strong><br>
        &bull; <strong>Deals Required:</strong> ${fmtUSD(targetVolumeDollars)} volume &divide; $${acv.toLocaleString()} ACV = <strong>${dealsNeededToWin.toFixed(1)} closed deals</strong><br>
        &bull; <strong>Proposal Stage Pace:</strong> ${dealsNeededToWin.toFixed(1)} wins &divide; ${(proposalWinRate * 100).toFixed(1)}% proposal win rate = <strong>${proposalsNeeded.toFixed(1)} proposals</strong> (&asymp; <strong>${paceProposals} ${unitLabel}</strong>)<br>
        &bull; <strong>Discovery Pacing:</strong> ${proposalsNeeded.toFixed(1)} proposals &divide; ${(convProposal * 100).toFixed(0)}% conversion = <strong>${discoveryCallsNeeded.toFixed(1)} calls</strong> (&asymp; <strong>${paceDiscovery} ${unitLabel}</strong>)<br>
        &bull; <strong>Intro Meetings:</strong> ${discoveryCallsNeeded.toFixed(1)} discovery &divide; ${(convDisc * 100).toFixed(0)}% held = <strong>${introMeetingsNeeded.toFixed(1)} intros</strong> (&asymp; <strong>${paceIntros} ${unitLabel}</strong>)
      `;

      renderPlaybooks(gapToQuota, weeksLeft, salesCycleDays);
      updateChart(closedWon, totalWeightedPipeline, gapToQuota, quota);
      renderGoogleSheetsGrid();
    }

    function renderPlaybooks(gapToQuota, weeksLeft, salesCycleDays) {
      const list = document.getElementById('playbookList');
      const tag = document.getElementById('programTag');
      if (!list) return;

      const daysLeft = weeksLeft * 7;
      const isCycleRisk = daysLeft < (salesCycleDays * 0.75);

      let plays = [];

      if (gapToQuota <= 0) {
        if (tag) {
          tag.textContent = 'Preserve & Future-Proof';
          tag.className = 'text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-medium';
        }
        plays = [
          {
            title: '1. Early Renewal & Multi-Year Upgrades',
            desc: 'Offer price-lock guarantees for accounts renewing in the next two quarters in exchange for early commitment before quarter end.',
            badge: 'Expansion',
            badgeColor: 'bg-emerald-50 text-emerald-700 border-emerald-200'
          },
          {
            title: '2. Next Quarter Pipeline Reload (Sprint 20%)',
            desc: 'Allocate 20% of your weekly calendar to top-of-funnel outbound for the following quarter to prevent the classic post-quota valley.',
            badge: 'Pipeline Health',
            badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
          }
        ];
      } else if (isCycleRisk) {
        if (tag) {
          tag.textContent = 'Cycle Risk Alert';
          tag.className = 'text-xs bg-rose-100 text-rose-800 px-2 py-0.5 rounded font-medium';
        }
        plays = [
          {
            title: '1. Silver Medalist (Closed-Lost Revival Play)',
            desc: `Days remaining (${daysLeft}d) is shorter than your sales cycle (${salesCycleDays}d). Cold outreach will NOT close in time. Target deals lost 3–6 months ago due to timing or budget where the champion is still active.`,
            badge: 'Speed to Close',
            badgeColor: 'bg-amber-50 text-amber-700 border-amber-200'
          },
          {
            title: '2. Executive Sponsor Alignment on Stage 3 & 4 Deals',
            desc: 'Pair your sales manager or leadership with the economic buyer on all deals in Proposal & Negotiation to remove procurement bottlenecks.',
            badge: 'Late Stage Acceleration',
            badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
          },
          {
            title: '3. Rapid Add-On & Expansion Packages',
            desc: 'Existing customer add-on cycles run under 14 days. Review active accounts with high product usage for immediate seat expansions.',
            badge: 'Fast Velocity',
            badgeColor: 'bg-emerald-50 text-emerald-700 border-emerald-200'
          }
        ];
      } else {
        if (tag) {
          tag.textContent = 'Active Sprint';
          tag.className = 'text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-medium';
        }
        plays = [
          {
            title: '1. Structured Outbound Cadence to High-Fit Accounts',
            desc: 'Run multi-channel sequences to drive new Intro meetings into Discovery. Target high-intent accounts to feed the top of funnel.',
            badge: 'Pipeline Gen',
            badgeColor: 'bg-blue-50 text-blue-700 border-blue-200'
          },
          {
            title: '2. Mutual Action Plan (MAP) for All Evaluation Deals',
            desc: 'Lock in agreed-upon security, procurement, and contract milestones with prospects currently evaluating proposals.',
            badge: 'Deal Governance',
            badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200'
          }
        ];
      }

      list.innerHTML = plays.map(p => `
