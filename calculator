<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trimble RevPace | Quota Forecaster & Pace Planner</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            trimble: {
              blue: '#0063a3',
              dark: '#004f83',
              navy: '#0e416c',
              light: '#217cbb',
              pale: '#e8f3fb',
              yellow: '#fbad26',
              yellowDark: '#e49325',
              gray: '#252a2e',
              neutral: '#595e63',
              green: '#1e8a44',
              red: '#da212c',
              border: '#dcedf9'
            }
          },
          fontFamily: {
            sans: ['"Open Sans"', 'Segoe UI', 'Roboto', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Open Sans', 'Segoe UI', Roboto, sans-serif;
      color: #252a2e;
    }
    input[type=range]::-webkit-slider-thumb {
      background: #0063a3;
      cursor: pointer;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
  </style>
</head>
<body class="bg-slate-50 text-trimble-gray min-h-screen antialiased">
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3 sm:space-x-4">
        <!-- Trimble Authentic Logomark & Wordmark -->
        <div class="flex items-center space-x-2.5">
          <div class="w-9 h-9 rounded-lg bg-trimble-blue flex items-center justify-center text-white shadow-sm shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
          </div>
          <div class="border-l border-slate-200 pl-3">
            <div class="flex items-center space-x-2">
              <span class="text-base sm:text-lg font-extrabold text-trimble-navy tracking-tight">Trimble</span>
              <span class="text-xs sm:text-sm font-semibold text-slate-600">RevPace</span>
              <span class="text-[10px] uppercase font-bold bg-trimble-pale text-trimble-dark px-2 py-0.5 rounded-full border border-trimble-border">Sales Ops</span>
            </div>
            <p class="text-[11px] text-slate-500">Rep Quota Forecaster & Weekly Pacing Calculator</p>
          </div>
        </div>
      </div>
      <div class="flex items-center space-x-2 sm:space-x-3">
        <button id="resetDefaultsBtn" class="px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors border border-slate-200">
          Reset Benchmarks
        </button>
        <button id="exportPlanBtn" class="px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-trimble-dark bg-trimble-pale hover:bg-blue-100 rounded-lg transition-colors flex items-center space-x-1.5 border border-trimble-border">
          <svg class="w-4 h-4 text-trimble-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
          </svg>
          <span class="hidden sm:inline">Copy 1:1 Plan</span>
          <span class="sm:hidden">Copy</span>
        </button>
        <button id="copyToSheetsBtn" class="px-3 sm:px-3.5 py-1.5 text-xs font-bold text-white bg-trimble-blue hover:bg-trimble-dark rounded-lg shadow-sm transition-colors flex items-center space-x-1.5">
          <svg class="w-4 h-4 text-trimble-yellow" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h10v2H7zm0 4h10v2H7zm0 4h7v2H7z"/>
          </svg>
          <span class="hidden sm:inline">Google Sheets Export</span>
          <span class="sm:hidden">Sheets</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- View Switcher Tabs -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
      <div class="flex items-center space-x-2">
        <button id="tabSimulatorBtn" class="px-4 py-2 text-xs font-bold rounded-xl bg-trimble-blue text-white shadow-sm flex items-center space-x-2 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <span>Rep Self-Serve Forecaster</span>
        </button>
        <button id="tabSheetsBtn" class="px-4 py-2 text-xs font-bold rounded-xl bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 shadow-sm flex items-center space-x-2 transition-all">
          <svg class="w-4 h-4 text-trimble-blue" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 2l5 5h-5V4zm-5 8h8v2H8v-2zm0 4h8v2H8v-2z" />
          </svg>
          <span>Google Sheets Formulas & Blueprint</span>
        </button>
      </div>

      <div class="flex items-center space-x-2 text-xs text-slate-500">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-trimble-blue animate-pulse"></span>
        <span class="font-medium">Calibrated with Trimble Verified Sales Operations Benchmarks ($5,869 ACV | 39.9% Win Rate)</span>
      </div>
    </div>

    <div id="simulatorView">
      <!-- Top Summary Banner -->
      <div id="statusAlert" class="mb-6 rounded-2xl p-4 sm:p-5 border transition-all duration-300 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-center space-x-4">
          <div id="statusIconBg" class="w-12 h-12 rounded-xl flex items-center justify-center text-white shrink-0 shadow-sm">
            <span id="statusIcon" class="text-2xl font-bold">🎯</span>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span id="statusBadge" class="text-xs uppercase font-extrabold px-2.5 py-0.5 rounded-full">On Track</span>
              <span id="statusRepName" class="text-xs font-semibold text-slate-500">Alex Morgan — 6 Wks Left</span>
            </div>
            <h2 id="statusHeadline" class="text-lg sm:text-xl font-bold text-trimble-navy mt-0.5">Projected to land at 100% of Quota</h2>
          </div>
        </div>
        <div class="flex items-center space-x-6 w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 pt-3 md:pt-0 border-slate-200">
          <div>
            <p class="text-xs text-slate-500 font-medium">Gap to Quota</p>
            <p id="gapMetric" class="text-lg font-bold text-slate-900">$0</p>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-medium">Weekly Intros Needed</p>
            <p id="weeklyIntrosMetric" class="text-lg font-bold text-trimble-blue">0.0 / wk</p>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-medium">Weekly Proposals Needed</p>
            <p id="weeklyProposalsMetric" class="text-lg font-bold text-trimble-green">0.0 / wk</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- LEFT COLUMN: Rep Inputs & Stage Data -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Rep Profile & Target Card -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-bold text-sm text-slate-900 flex items-center space-x-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-trimble-blue inline-block"></span>
                  <span>1. Your Target & Quarter Status</span>
                </h3>
                <p class="text-[11px] text-slate-500 mt-0.5">Enter your individual quarterly numbers</p>
              </div>
              <div class="flex space-x-1">
                <button type="button" id="presetBehindBtn" class="text-[10px] bg-slate-100 hover:bg-slate-200 text-slate-600 px-2 py-0.5 rounded font-medium">Deficit Demo</button>
                <button type="button" id="presetAheadBtn" class="text-[10px] bg-slate-100 hover:bg-slate-200 text-slate-600 px-2 py-0.5 rounded font-medium">Ahead Demo</button>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3.5">
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Rep Name</label>
                <input type="text" id="inputRepName" value="Alex Morgan" class="w-full text-xs sm:text-sm font-semibold rounded-lg border border-slate-200 px-3 py-2 focus:ring-2 focus:ring-trimble-blue focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Weeks Left in Quarter</label>
                <input type="number" id="inputWeeksLeft" min="1" max="13" value="6" class="w-full text-xs sm:text-sm font-semibold rounded-lg border border-slate-200 px-3 py-2 focus:ring-2 focus:ring-trimble-blue focus:outline-none">
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3.5">
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Quarterly Quota ($)</label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs font-semibold text-slate-400">$</span>
                  <input type="number" id="inputQuota" step="5000" value="150000" class="w-full pl-7 text-xs sm:text-sm font-bold rounded-lg border border-slate-200 px-3 py-2 focus:ring-2 focus:ring-trimble-blue focus:outline-none text-slate-900">
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Closed-Won Bookings ($)</label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs font-semibold text-slate-400">$</span>
                  <input type="number" id="inputClosedWon" step="2500" value="35000" class="w-full pl-7 text-xs sm:text-sm font-bold rounded-lg border border-slate-200 px-3 py-2 focus:ring-2 focus:ring-trimble-green focus:outline-none text-trimble-green font-bold">
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3.5 pt-1">
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label class="block text-xs font-medium text-slate-600">Average Deal Size (ACV)</label>
                  <button type="button" id="resetACVBtn" title="Reset to verified Trimble Salesforce benchmark ($5,869)" class="text-[10px] text-trimble-blue font-semibold hover:underline">Trimble SFDC $5,869</button>
                </div>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs font-semibold text-slate-400">$</span>
                  <input type="number" id="inputACV" step="100" value="5869" class="w-full pl-7 text-xs sm:text-sm font-medium rounded-lg border border-slate-200 px-3 py-2 focus:ring-2 focus:ring-trimble-blue focus:outline-none">
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Avg Sales Cycle (Days)</label>
                <input type="number" id="inputSalesCycle" step="5" value="32" class="w-full text-xs sm:text-sm font-medium rounded-lg border border-slate-200 px-3 py-2 focus:ring-2 focus:ring-trimble-blue focus:outline-none">
              </div>
            </div>
          </div>

          <!-- Active Pipeline by Stage Card -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-bold text-sm text-slate-900 flex items-center space-x-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-trimble-blue inline-block"></span>
                  <span>2. Current Active Pipeline by Stage</span>
                </h3>
                <p class="text-[11px] text-slate-500 mt-0.5">Preloaded with verified Trimble stage win rates</p>
              </div>
              <span class="text-xs text-slate-500 font-semibold" id="totalRawPipelineDisplay">Total: $0</span>
            </div>

            <div class="space-y-3.5" id="stagesContainer">
              <!-- Dynamically populated rows with verified SFDC benchmarks -->
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
              <span class="font-medium">Calculated Weighted Pipeline:</span>
              <span id="calculatedWeightedPipe" class="font-bold text-trimble-blue text-sm">$0</span>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-bold text-sm text-slate-900 flex items-center space-x-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-trimble-yellow inline-block"></span>
                  <span>3. Top-of-Funnel Conversion Ratios</span>
                </h3>
                <p class="text-[11px] text-slate-500 mt-0.5">Used to waterfall your weekly activity goals</p>
              </div>
              <span class="text-xs text-trimble-yellowDark bg-amber-50 border border-amber-200 font-bold px-2 py-0.5 rounded">Activity Rates</span>
            </div>

            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-xs font-medium text-slate-700 mb-1">
                  <span>Target Accounts Contacted &rarr; Intro Meeting Held</span>
                  <span id="convIntroLabel" class="font-bold text-trimble-blue">20%</span>
                </div>
                <input type="range" id="inputConvIntro" min="5" max="50" value="20" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer">
              </div>

              <div>
                <div class="flex justify-between text-xs font-medium text-slate-700 mb-1">
                  <span>Intro Meeting Held &rarr; Qualified Discovery Call</span>
                  <span id="convDiscLabel" class="font-bold text-trimble-blue">65%</span>
                </div>
                <input type="range" id="inputConvDisc" min="20" max="95" value="65" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer">
              </div>

              <div>
                <div class="flex justify-between text-xs font-medium text-slate-700 mb-1">
                  <span>Discovery &rarr; Quote & Proposal / Late Stage</span>
                  <span id="convNeedsLabel" class="font-bold text-trimble-blue">54%</span>
                </div>
                <input type="range" id="inputConvNeeds" min="20" max="95" value="54" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer">
              </div>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: Output Dashboard, Charts & Action Plan -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Key Metrics Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm relative overflow-hidden">
              <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Projected Land</div>
              <div id="cardProjectedTotal" class="text-2xl font-black text-slate-900 mt-1">$0</div>
              <div id="cardQuotaPct" class="text-xs font-bold text-trimble-green mt-1">0% of Quota</div>
              <div class="w-1.5 h-full absolute left-0 top-0 bg-trimble-blue"></div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm relative overflow-hidden">
              <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Shortfall / Surplus</div>
              <div id="cardGapAmount" class="text-2xl font-black text-slate-900 mt-1">$0</div>
              <div id="cardGapSubtext" class="text-xs font-semibold text-slate-500 mt-1">Remaining gap to quota</div>
              <div id="cardGapBar" class="w-1.5 h-full absolute left-0 top-0 bg-trimble-yellow"></div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm relative overflow-hidden">
              <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Pipeline Coverage</div>
              <div id="cardCoverageRatio" class="text-2xl font-black text-slate-900 mt-1">0.0x</div>
              <div id="cardCoverageHealth" class="text-xs font-medium text-slate-500 mt-1">SFDC Baseline: 2.51x</div>
              <div class="w-1.5 h-full absolute left-0 top-0 bg-trimble-light"></div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="font-bold text-sm text-slate-900">Revenue Landing Breakdown</h3>
                <p class="text-xs text-slate-500">Booked Revenue + Weighted Active Pipeline vs Quota</p>
              </div>
              <span id="chartAttainmentPill" class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">Pacing</span>
            </div>

            <div class="relative w-full h-56">
              <canvas id="forecastChart"></canvas>
            </div>

            <!-- Progress Bar to Quota -->
            <div class="space-y-1.5 pt-2 border-t border-slate-100">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-slate-600">Attainment Progress Bar</span>
                <span id="quotaProgressText" class="font-bold text-slate-800">0%</span>
              </div>
              <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden flex">
                <div id="barClosedWon" class="bg-trimble-green h-full transition-all duration-500" style="width: 30%"></div>
                <div id="barWeightedPipe" class="bg-trimble-blue h-full transition-all duration-500" style="width: 45%"></div>
              </div>
              <div class="flex items-center justify-between text-[11px] text-slate-400">
                <div class="flex items-center space-x-1.5">
                  <span class="inline-block w-2.5 h-2.5 rounded-sm bg-trimble-green"></span>
                  <span>Closed Won</span>
                </div>
                <div class="flex items-center space-x-1.5">
                  <span class="inline-block w-2.5 h-2.5 rounded-sm bg-trimble-blue"></span>
                  <span>Weighted Open Pipe</span>
                </div>
                <div class="flex items-center space-x-1.5">
                  <span class="inline-block w-2.5 h-2.5 rounded-sm bg-slate-200"></span>
                  <span>Remaining Gap</span>
                </div>
              </div>
            </div>
          </div>

          <!-- The Rep Action Mandate Card -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-bold text-sm text-slate-900 flex items-center space-x-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-trimble-green inline-block"></span>
                  <span>4. What You Need to Do Each Week to Hit Your Number</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Required pace across the remaining <span id="weeksCallout" class="font-bold text-slate-800">6</span> weeks (based on $5,869 ACV)</p>
              </div>
              <div class="flex items-center space-x-1 bg-slate-100 p-0.5 rounded-lg text-[11px]">
                <button type="button" id="btnViewWeekly" class="px-2.5 py-1 rounded-md font-bold bg-white text-slate-800 shadow-sm">Weekly</button>
                <button type="button" id="btnViewDaily" class="px-2.5 py-1 rounded-md font-medium text-slate-600 hover:text-slate-800">Daily</button>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 text-center">
                <span class="text-[11px] text-slate-500 font-medium block">Deals to Win</span>
                <span id="metricWinsNeeded" class="text-xl font-black text-slate-900 mt-1 block">0.0</span>
                <span id="metricWinsPace" class="text-[10px] text-slate-500 font-semibold block mt-0.5">0.0 / wk</span>
              </div>

              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 text-center">
                <span class="text-[11px] text-slate-500 font-medium block">Quotes / Proposals</span>
                <span id="metricProposalsTotal" class="text-xl font-black text-trimble-blue mt-1 block">0</span>
                <span id="metricProposalsPace" class="text-[10px] text-trimble-blue font-bold block mt-0.5">0 / wk</span>
              </div>

              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 text-center">
                <span class="text-[11px] text-slate-500 font-medium block">Discovery Calls</span>
                <span id="metricDiscTotal" class="text-xl font-black text-slate-900 mt-1 block">0</span>
                <span id="metricDiscPace" class="text-[10px] text-slate-500 font-semibold block mt-0.5">0 / wk</span>
              </div>

              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 text-center">
