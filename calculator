    function renderGoogleSheetsGrid() {
      const rows = getGoogleSheetsModel();
      const tbody = document.getElementById('sheetsGridBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      rows.forEach(r => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-indigo-50/40 transition-colors cursor-pointer group';

        if (r.type === 'header') {
          tr.className = 'bg-slate-800 text-white font-bold font-sans text-xs';
          tr.innerHTML = `
            <td class="py-2.5 px-3 text-center border-r border-slate-700 font-mono text-[10px] text-slate-400">${r.row}</td>
            <td colspan="5" class="py-2.5 px-3.5 tracking-wider text-emerald-400">${r.a}</td>
          `;
        } else if (r.type === 'section') {
          tr.className = 'bg-slate-100 font-bold font-sans text-[11px] text-slate-800 border-t-2 border-slate-200';
          tr.innerHTML = `
            <td class="py-2 px-3 text-center border-r border-slate-200 font-mono text-[10px] text-slate-400">${r.row}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 text-indigo-900">${r.a}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 text-slate-600">${r.b}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 text-slate-600">${r.c}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 text-slate-600">${r.d}</td>
            <td class="py-2 px-3.5 text-slate-600">${r.e}</td>
          `;
        } else if (r.type === 'blank') {
          tr.className = 'bg-slate-50/50 h-5';
          tr.innerHTML = `
            <td class="py-1 px-3 text-center border-r border-slate-200 font-mono text-[10px] text-slate-300">${r.row}</td>
            <td colspan="5" class="py-1 px-3.5"></td>
          `;
        } else {
          const displayB = typeof r.b === 'string' && r.b.startsWith('=') 
            ? `<span class="text-indigo-600 font-bold">${r.b}</span>`
            : (typeof r.b === 'number' ? (r.c === 'USD' ? fmtUSD(r.b) : (r.c === '% of Quota' ? `${Math.round(r.b*100)}%` : r.b)) : (r.f_b || r.b));

          const displayC = typeof r.c === 'string' && r.c.startsWith('=')
            ? `<span class="text-indigo-600 font-bold">${r.c}</span>`
            : (r.f_c || r.c);

          const displayD = typeof r.d === 'string' && r.d.startsWith('=')
            ? `<span class="text-indigo-600 font-bold">${r.d}</span>`
            : r.d;

          const displayE = typeof r.e === 'string' && r.e.startsWith('=')
            ? `<span class="text-indigo-600 font-bold">${r.e}</span>`
            : r.e;

          tr.innerHTML = `
            <td class="py-2 px-3 text-center border-r border-slate-200 font-mono text-[10px] text-slate-400 group-hover:text-indigo-600 bg-slate-50/60">${r.row}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 font-sans font-medium text-slate-900" data-cell="A${r.row}" data-formula="${r.a}">${r.a}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 font-mono" data-cell="B${r.row}" data-formula="${r.b}" data-desc="${r.exp_b || r.e || ''}">${displayB}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 font-sans text-slate-600" data-cell="C${r.row}" data-formula="${r.c}">${displayC}</td>
            <td class="py-2 px-3.5 border-r border-slate-200 font-mono text-slate-700" data-cell="D${r.row}" data-formula="${r.d}" data-desc="${r.exp_d || ''}">${displayD}</td>
            <td class="py-2 px-3.5 font-sans text-slate-500 text-[11px]" data-cell="E${r.row}" data-formula="${r.e}">${displayE}</td>
          `;

          tr.querySelectorAll('td[data-cell]').forEach(td => {
            td.addEventListener('click', () => {
              const cell = td.dataset.cell;
              const formula = td.dataset.formula || td.textContent;
              const desc = td.dataset.desc || '';
              document.getElementById('formulaCellAddress').textContent = cell;
              document.getElementById('formulaBarContent').textContent = formula;
