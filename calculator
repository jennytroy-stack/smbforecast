              td.classList.add('bg-indigo-100/70', 'ring-1', 'ring-indigo-400');
            });
          });
        }

        tbody.appendChild(tr);
      });
    }

    function generateGoogleSheetsTSV() {
      const rows = getGoogleSheetsModel();
      return rows.map(r => {
        if (r.type === 'blank') return '\t\t\t\t';
        if (r.type === 'header') return `${r.a}\t\t\t\t`;
        const valB = typeof r.b !== 'undefined' ? r.b : '';
        const valC = typeof r.c !== 'undefined' ? r.c : '';
        const valD = typeof r.d !== 'undefined' ? r.d : '';
        const valE = typeof r.e !== 'undefined' ? r.e : '';
        return `${r.a}\t${valB}\t${valC}\t${valD}\t${valE}`;
      }).join('\n');
    }

    function generateGoogleSheetsCSV() {
      const rows = getGoogleSheetsModel();
      return rows.map(r => {
        if (r.type === 'blank') return ',,,,';
        const clean = (val) => {
          if (val === null || typeof val === 'undefined') return '""';
          const str = String(val).replace(/"/g, '""');
          return `"${str}"`;
        };
        return [clean(r.a), clean(r.b), clean(r.c), clean(r.d), clean(r.e)].join(',');
      }).join('\r\n');
    }

