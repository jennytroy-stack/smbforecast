                <th class="py-2 px-3.5 border-r border-slate-200 font-semibold text-slate-700 min-w-[140px]">C (Unit / Rate / Weekly)</th>
                <th class="py-2 px-3.5 border-r border-slate-200 font-semibold text-slate-700 min-w-[150px]">D (Weighted $ / Calc)</th>
                <th class="py-2 px-3.5 font-semibold text-slate-700 min-w-[200px]">E (Deals / Logic Breakdown)</th>
              </tr>
