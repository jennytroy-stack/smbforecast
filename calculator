    function updateChart(closedWon, weightedPipe, gap, quota) {
      const ctx = document.getElementById('forecastChart');
      if (!ctx) return;
      
      if (forecastChartInstance) {
        forecastChartInstance.destroy();
      }

      const projected = closedWon + weightedPipe;
      const attainment = Math.round((projected / quota) * 100);
      
      forecastChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Current Won', 'Weighted Pipe', 'Projected Total', 'Quota Target'],
          datasets: [{
            label: 'Revenue ($)',
            data: [closedWon, weightedPipe, projected, quota],
            backgroundColor: [
              '#1e8a44', // Trimble Green
              '#0063a3', // Trimble Blue
              projected >= quota ? '#004f83' : '#fbad26', // Trimble Dark or Yellow
              '#252a2e'  // Trimble Gray
            ],
            borderRadius: 8,
            borderSkipped: false
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ' ' + fmtUSD(context.parsed.y);
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return '$' + (value >= 1000 ? (value / 1000) + 'k' : value);
                },
                font: { family: 'Open Sans', size: 10 }
              },
              grid: { color: '#f1f5f9' }
            },
            x: {
              ticks: { font: { family: 'Open Sans', size: 11, weight: '600' } },
              grid: { display: false }
            }
          }
        }
      });

      const chartAttainmentPill = document.getElementById('chartAttainmentPill');
      if (chartAttainmentPill) {
        chartAttainmentPill.textContent = `${attainment}% of Quota`;
        chartAttainmentPill.className = attainment >= 100
          ? 'text-xs font-extrabold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800'
          : (attainment >= 80 
             ? 'text-xs font-extrabold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800'
