    // Copy and export actions
    document.getElementById('copyToSheetsBtn').addEventListener('click', copyGoogleSheetsClipboard);
    document.getElementById('copySheetDirectBtn').addEventListener('click', copyGoogleSheetsClipboard);
    document.getElementById('downloadCsvBtn').addEventListener('click', downloadGoogleSheetsCSV);

    document.getElementById('resetDefaultsBtn').addEventListener('click', () => {
      stages = JSON.parse(JSON.stringify(defaultStages));
      document.getElementById('inputRepName').value = 'Alex Morgan';
      document.getElementById('inputWeeksLeft').value = 6;
      document.getElementById('inputQuota').value = 150000;
      document.getElementById('inputClosedWon').value = 35000;
      document.getElementById('inputACV').value = 5869;
      document.getElementById('inputSalesCycle').value = 32;
      document.getElementById('inputConvIntro').value = 20;
      document.getElementById('inputConvDisc').value = 65;
      document.getElementById('inputConvNeeds').value = 54;
      renderStageInputs();
      calculateAndRender();
      showToast('Reset to verified SFDC benchmarks ($5,869 ACV | 39.9% WR)');
    });

    document.getElementById('exportPlanBtn').addEventListener('click', () => {
      const repName = document.getElementById('inputRepName').value || 'Rep';
      const quota = parseFloat(document.getElementById('inputQuota').value) || 0;
      const closedWon = parseFloat(document.getElementById('inputClosedWon').value) || 0;
      const weeksLeft = document.getElementById('inputWeeksLeft').value || 6;
      const proj = document.getElementById('cardProjectedTotal').textContent;
      const gap = document.getElementById('gapMetric').textContent;
      const weeklyWins = document.getElementById('metricWinsPace').textContent;
      const weeklyProposals = document.getElementById('metricProposalsPace').textContent;
      const weeklyDisc = document.getElementById('metricDiscPace').textContent;
      const weeklyIntros = document.getElementById('metricIntroPace').textContent;

      const summary = `RevPace Quota Pacing Plan for ${repName}
- Quota: ${fmtUSD(quota)} | Closed-Won: ${fmtUSD(closedWon)}
- Weeks Remaining: ${weeksLeft}
- Projected Landing: ${proj}
- Quota Gap / Surplus: ${gap}
- Required Pace:
  - Closed Deals: ${weeklyWins}
  - Quotes/Proposals: ${weeklyProposals}
  - Discovery Calls: ${weeklyDisc}
  - Intro Meetings: ${weeklyIntros}`;

      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = summary;
      tempTextArea.style.position = 'fixed';
      tempTextArea.style.left = '-9999px';
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      try {
        document.execCommand('copy');
        showToast('1:1 Plan summary copied to clipboard!');
      } catch (e) {
        showToast('Unable to copy summary.');
      }
      document.body.removeChild(tempTextArea);
    });

    // Inputs event listeners
    ['inputRepName', 'inputWeeksLeft', 'inputQuota', 'inputClosedWon', 'inputACV', 'inputSalesCycle'].forEach(id => {
      document.getElementById(id).addEventListener('input', calculateAndRender);
    });

    ['inputConvIntro', 'inputConvDisc', 'inputConvNeeds'].forEach(id => {
      document.getElementById(id).addEventListener('input', calculateAndRender);
    });

    // Initialize on window load
    window.addEventListener('DOMContentLoaded', () => {
      renderStageInputs();
      calculateAndRender();
    });
  </script>
</body>
</html>
